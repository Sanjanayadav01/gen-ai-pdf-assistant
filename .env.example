# Pick ONE provider and set its key. Leave the key empty to run in extractive demo mode.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# LLM_PROVIDER=openai
# OPENAI_API_KEY=
